<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact surfaces and actions, scoped to the freezer. Touch targets remain 48dp. -->
    <style name="NMS.IceAction" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:singleLine">true</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="NMS.IceAction.Primary" parent="NMS.IceAction">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <!-- One mode selector beside search replaces a full row of filter chips. -->
    <style name="NMS.IceModeFilter" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:singleLine">true</item>
        <item name="cornerRadius">16dp</item>
        <item name="icon">@drawable/ic_expand</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="NMS.IceAction.Text" parent="NMS.IceAction">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minWidth">48dp</item>
    </style>

    <!-- Full-width settings actions can wrap at word boundaries at large font sizes. -->
    <style name="NMS.IceSettingAction" parent="NMS.IceAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:singleLine">false</item>
    </style>

    <style name="NMS.IceActionBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="NMS.IceActionRow" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="NMS.IceCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="NMS.IceSection" parent="NMS.Section">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="NMS.IceHint" parent="NMS.Hint">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="NMS.IceInfo" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="icon">@drawable/ic_info</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="NMS.IceSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="NMS.IceSheetTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/NMS.IceSheet</item>
    </style>
</resources>
