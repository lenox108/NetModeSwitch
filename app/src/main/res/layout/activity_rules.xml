<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/rules_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- access -->
            <TextView
                style="@style/NMS.Section"
                android:layout_marginTop="4dp"
                android:text="@string/sec_access" />

            <com.google.android.material.card.MaterialCardView style="@style/NMS.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/permEntry"
                        layout="@layout/row_perm" />

                    <include
                        android:id="@+id/checkEntry"
                        layout="@layout/row_perm" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/NMS.RowLabel"
                            android:text="@string/backend_title" />

                        <com.netmode.switcher.ChoiceView
                            android:id="@+id/backend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/NMS.Section"
                android:text="@string/wifi_country_section" />
            <com.google.android.material.card.MaterialCardView style="@style/NMS.Card">
                <include
                    android:id="@+id/wifiCountryEntry"
                    layout="@layout/row_perm" />
            </com.google.android.material.card.MaterialCardView>

            <!-- primary and secondary SIM -->
            <TextView
                style="@style/NMS.Section"
                android:text="@string/dual_title" />

            <com.google.android.material.card.MaterialCardView style="@style/NMS.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/dualRow"
                        layout="@layout/row_switch" />

                    <LinearLayout
                        android:id="@+id/dualBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/NMS.RowLabel"
                                android:text="@string/dual_primary" />

                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/dualPrimary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/NMS.RowLabel"
                                android:text="@string/dual_secondary" />

                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/dualSecondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dualNow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="?attr/colorSurfaceContainerHighest"
                            android:lineSpacingExtra="3dp"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dualHow"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:paddingStart="0dp"
                        android:text="@string/how_it_works" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- background work -->
            <TextView
                style="@style/NMS.Section"
                android:text="@string/sec_background" />

            <com.google.android.material.card.MaterialCardView style="@style/NMS.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/reliableRow"
                        layout="@layout/row_switch" />

                    <include
                        android:id="@+id/notifyRow"
                        layout="@layout/row_switch" />

                    <include
                        android:id="@+id/catchUpRow"
                        layout="@layout/row_switch" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- backup -->
            <TextView
                style="@style/NMS.Section"
                android:text="@string/sec_backup" />

            <com.google.android.material.card.MaterialCardView style="@style/NMS.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/NMS.Hint"
                        android:layout_marginTop="0dp"
                        android:text="@string/backup_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/exportBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/backup_export" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/importBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/backup_import" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
