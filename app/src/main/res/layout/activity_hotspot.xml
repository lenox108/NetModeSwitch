<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ap_title" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ap_quick_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopHotspot"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="@string/ap_stop" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:id="@+id/quickActions"
                android:layout_marginBottom="4dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startVpn"
                    style="@style/NMS.HotspotQuick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/ap_quick_vpn" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startProxy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/NMS.HotspotQuick"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/ap_quick_proxy"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                style="@style/NMS.HotspotCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_presets_title"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:paddingStart="4dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addPreset"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/ap_preset_add"
                            app:icon="@drawable/ic_add" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/presetGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView
                        android:id="@+id/presetHint"
                        style="@style/NMS.Hint"
                        android:layout_marginTop="4dp"
                        android:text="@string/ap_presets_hint" />
                    <TextView
                        android:id="@+id/presetStatus"
                        style="@style/NMS.Hint"
                        android:visibility="gone"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/NMS.HotspotCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ap_live_title"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/refreshLive"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ap_refresh_short" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="@string/ap_live_wait" />
                    <TextView
                        android:id="@+id/liveTraffic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ap_live_wait"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/statsToggle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ap_stats_details"
                            android:gravity="start|center_vertical"
                            style="@style/Widget.Material3.Button.TextButton"
                            app:icon="@drawable/ic_expand"
                            android:layout_weight="1"
                            android:paddingStart="0dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/captureReport"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ap_diagnostics_short"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/statsDetails"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/liveDetails"
                            style="@style/NMS.Hint" />
                        <TextView
                            style="@style/NMS.Hint"
                            android:text="@string/ap_traffic_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/NMS.HotspotCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tether_section"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        style="@style/NMS.Hint"
                        android:text="@string/ap_route_immediate" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/routeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routeDirect"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_route_direct" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routeVpn"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VPN" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routeProxy"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Proxy" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <LinearLayout
                        android:id="@+id/proxyRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="0.7"
                            android:text="@string/tether_proxy_addr"
                            android:textSize="14sp" />
                        <com.netmode.switcher.ChoiceView
                            android:id="@+id/proxyAddr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tetherStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ap_band"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="16dp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/bandPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/band2"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_band_2" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/band5"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_band_5" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/band6"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_band_6" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/bandExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bandAuto"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_auto" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/bandDual"
                            style="@style/NMS.HotspotChoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_band_dual"
                            android:contentDescription="@string/ap_band_dual_description" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bandKeep"
                        style="@style/NMS.HotspotChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:visibility="gone"
                        android:text="@string/ap_band_keep" />
                    <TextView
                        android:id="@+id/bandHint"
                        style="@style/NMS.Hint" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wifiCountry"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_country_title" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ap_channel"
                            android:textSize="15sp" />
                        <com.netmode.switcher.ChoiceView
                            android:id="@+id/channel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView
                        style="@style/NMS.Hint"
                        android:text="@string/ap_band_save_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/NMS.HotspotCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ap_peers_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:id="@+id/peersStatus"
                        style="@style/NMS.Hint"
                        android:text="@string/ap_live_wait" />
                    <LinearLayout
                        android:id="@+id/peerList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/NMS.HotspotCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/identityToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ap_identity_title"
                        android:gravity="start|center_vertical"
                        style="@style/Widget.Material3.Button.TextButton"
                        app:icon="@drawable/ic_expand"
                        app:iconGravity="end" />
                    <TextView
                        android:id="@+id/savedSummary"
                        style="@style/NMS.Hint"
                        android:text="@string/ap_settings_section_hint" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/identityDetails"
                        android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/ap_ssid">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ssid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLength="32"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/passLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/ap_pass"
                            app:endIconMode="password_toggle">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLength="63"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ap_security"
                                android:textSize="15sp" />
                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/security"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/NMS.HotspotCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/advancedToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ap_advanced_title"
                        android:gravity="start|center_vertical"
                        style="@style/Widget.Material3.Button.TextButton"
                        app:icon="@drawable/ic_expand"
                        app:iconGravity="end" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/advancedDetails"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ap_wifi_advanced"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ap_clients"
                                android:textSize="15sp" />
                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/clients"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/autoOff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/ap_autooff" />
                        <LinearLayout
                            android:id="@+id/timeoutRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:alpha="0.7"
                                android:text="@string/ap_timeout"
                                android:textSize="14sp" />
                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/timeout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/hidden"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/ap_hidden" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/ax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/ap_ax" />
                        <TextView
                            style="@style/NMS.Hint"
                            android:text="@string/ap_ax_hint" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/randomMac"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/ap_mac" />
                        <TextView
                            style="@style/NMS.Hint"
                            android:text="@string/ap_channel_hint" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tether_ttl_section"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="8dp" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/fixTtl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="@string/tether_ttl_enabled" />
                        <LinearLayout
                            android:id="@+id/ttlRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/tether_ttl_value" />
                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/ttlValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:enabled="false" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tweaksOffloadHint"
                            style="@style/NMS.Hint"
                            android:text="@string/tether_ttl_offload_hint" />
                        <TextView
                            android:id="@+id/tweaksStatus"
                            style="@style/NMS.Hint"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/tether_tweaks_off" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/checkTweaks"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="@string/tether_tweaks_check" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ap_checks_title"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            style="@style/NMS.Hint"
                            android:text="@string/tether_hint" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/checkTether"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tether_check" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/ap_save_wifi" />
</LinearLayout>
