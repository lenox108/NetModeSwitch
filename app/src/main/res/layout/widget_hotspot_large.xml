<?xml version="1.0" encoding="utf-8"?>
<!-- The backing is its own layer, so its opacity can change without touching the content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg" />

    <LinearLayout
        android:id="@+id/h_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/h_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/w_ic_hotspot"
                android:tint="@color/w_text2" />

            <TextView
                android:id="@+id/h_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/w_ap_title"
                android:textColor="@color/w_text2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/h_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="Через Proxy"
            android:textColor="@color/w_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/h_direct"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/w_btn"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/w_ap_direct_short"
                android:textColor="@color/w_on_btn"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h_vpn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/w_btn"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/w_ap_vpn"
                android:textColor="@color/w_on_btn"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/h_proxy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/w_btn"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/w_ap_proxy"
                android:textColor="@color/w_on_btn"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
