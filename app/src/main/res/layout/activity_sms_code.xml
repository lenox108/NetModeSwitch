<?xml version="1.0" encoding="utf-8"?>
<!-- "Коды из СМС": its own screen, opened from the main page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/sec_sms_code" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/NMS.Hint"
                android:layout_marginTop="4dp"
                android:text="@string/sms_code_screen_hint" />

            <com.google.android.material.card.MaterialCardView style="@style/NMS.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/smsCodeRow"
                        layout="@layout/row_switch" />

                    <LinearLayout
                        android:id="@+id/smsCodeBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/smsNotifRow"
                            layout="@layout/row_switch" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/NMS.RowLabel"
                                android:text="@string/sms_code_clear" />

                            <com.netmode.switcher.ChoiceView
                                android:id="@+id/smsClear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <include
                            android:id="@+id/smsPasteRow"
                            layout="@layout/row_switch" />

                        <include
                            android:id="@+id/smsExcludeEntry"
                            layout="@layout/row_perm" />

                        <include
                            android:id="@+id/smsTestEntry"
                            layout="@layout/row_perm" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/smsExcludeHelp"
                style="@style/NMS.Hint"
                android:layout_marginTop="12dp"
                android:text="@string/sms_code_exclude_help" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
