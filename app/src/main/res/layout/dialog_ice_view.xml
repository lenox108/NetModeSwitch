<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView style="@style/NMS.Section" android:text="@string/ice_view_kind" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/kinds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- Titles in their own row: a title that wraps must not push its picker below the other. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <TextView
                style="@style/NMS.Section"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:text="@string/ice_columns_title" />
            <TextView
                style="@style/NMS.Section"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:text="@string/ice_rows_title" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <NumberPicker
                android:id="@+id/columns"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants" />
            <NumberPicker
                android:id="@+id/rows"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
        <TextView style="@style/NMS.Hint" android:text="@string/ice_view_columns_hint" />
        <TextView style="@style/NMS.Hint" android:text="@string/ice_view_rows_hint" />

        <TextView style="@style/NMS.Section" android:text="@string/ice_view_size" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ice_view_labels" />
    </LinearLayout>
</ScrollView>
