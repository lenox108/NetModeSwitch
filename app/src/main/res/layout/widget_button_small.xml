<?xml version="1.0" encoding="utf-8"?>
<!-- The backing is its own layer, so its opacity can change without touching the content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg_small" />

    <LinearLayout
        android:id="@+id/b_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/b_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/w_ic_t_net"
            android:tint="@color/w_text2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/b_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SIM 1"
            android:textColor="@color/w_text2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/b_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="4G"
            android:textColor="@color/w_accent"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
