<?xml version="1.0" encoding="utf-8"?>
<!-- The freezer's settings: the default way of freezing and delay, launching, shortcuts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ice_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewSettings"
                style="@style/NMS.IceSettingAction"
                android:text="@string/ice_view" />

            <TextView style="@style/NMS.Hint" android:text="@string/ice_undo_hint" />

            <TextView
                style="@style/NMS.Section"
                android:text="@string/ice_sec_default_mode" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/softCard"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:checkedIcon="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/softRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ice_mode_soft"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            style="@style/NMS.Hint"
                            android:text="@string/ice_mode_soft_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deepCard"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:checkedIcon="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/deepRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ice_mode_deep"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            style="@style/NMS.Hint"
                            android:text="@string/ice_mode_deep_hint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/NMS.Hint"
                android:layout_marginTop="6dp"
                android:text="@string/ice_mode_per_app" />

            <TextView
                style="@style/NMS.Section"
                android:text="@string/ice_sec_auto" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ice_sec_delay"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/delays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <include
                android:id="@+id/screenOff"
                layout="@layout/row_switch" />

            <include
                android:id="@+id/keepBusy"
                layout="@layout/row_switch" />

            <TextView
                style="@style/NMS.Section"
                android:text="@string/ice_sec_launch" />

            <include
                android:id="@+id/noConfirm"
                layout="@layout/row_switch" />

            <include
                android:id="@+id/nativeInstant"
                layout="@layout/row_switch" />

            <TextView
                style="@style/NMS.Section"
                android:text="@string/ice_sec_shortcuts" />

            <include
                android:id="@+id/badge"
                layout="@layout/row_switch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pinFolder"
                style="@style/NMS.IceSettingAction"
                android:text="@string/ice_pin_folder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTile"
                style="@style/NMS.IceSettingAction"
                android:text="@string/ice_add_tile" />

            <TextView
                style="@style/NMS.Hint"
                android:text="@string/ice_tile_hint" />

            <TextView
                style="@style/NMS.Section"
                android:text="@string/ice_sec_rules" />

            <include
                android:id="@+id/respectRules"
                layout="@layout/row_switch" />

            <include
                android:id="@+id/bootCheck"
                layout="@layout/row_switch" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
